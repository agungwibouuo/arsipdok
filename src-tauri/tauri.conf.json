{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ArsipDok",
  "version": "0.1.0",
  "identifier": "id.arsipdok.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "ArsipDok — Pengarsip Dokumentasi Foto & Video",
        "width": 1200,
        "height": 850,
        "minWidth": 620,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Indonesian"]
      }
    }
  }
}
